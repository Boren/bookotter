# BookOtter Configuration File

# Hardcover API Settings
hardcover:
  api_token: "Bearer YOUR_API_TOKEN_HERE"  # Get from https://hardcover.app/account/api
  api_url: "https://api.hardcover.app/v1/graphql"

# Prowlarr (Search Indexer)
prowlarr:
  api_key: ""                    # Prowlarr API key
  base_url: "http://localhost:9696"  # Prowlarr URL

# qBittorrent (Download Client)
qbittorrent:
  base_url: "http://localhost:8080"  # qBittorrent Web UI URL
  username: "admin"
  password: ""                    # qBittorrent Web UI password
  category: "books"              # Torrent category for BookOtter downloads

# E-reader Devices (supports multiple E-readers)
ereaders:
  - id: "main"                           # Unique identifier for this E-reader
    name: "My E-reader"                    # Display name
    hostname: "your-ereader-hostname"     # Your E-reader's Tailscale hostname or IP
    port: 22                             # SSH port (default: 22)
    username: "root"                     # SSH username (usually 'root' for jailbroken E-readers)
    password: ""                         # Leave empty if using SSH key
    ssh_key_path: "~/.ssh/id_rsa"        # Path to SSH private key (if using key auth)
    destination_path: "/mnt/us/books/"   # Destination path on E-reader
  # Add more E-readers by duplicating the block above:
  # - id: "backup"
  #   name: "Backup E-reader"
  #   hostname: "ereader-2.tailnet.ts.net"
  #   ...

# Library Settings
library:
  root_folders: []               # Managed via web UI
  download_path: ""              # Display only — qBittorrent manages actual paths

# Pipeline (Automation)
pipeline:
  enabled: true
  search_on_add: true            # Auto-search Prowlarr when book added
  import_on_complete: true       # Auto-import when download completes
  ereader_sync_on_import: true    # Auto-sync to E-reader after import
  status_actions:
    want_to_read:
      download: true
      ereader_sync: true
    currently_reading:
      download: true
      ereader_sync: true
    read:
      download: true
      ereader_sync: false

# Matching Settings
matching:
  use_isbn: true  # Try ISBN matching first
  use_fuzzy: true  # Fall back to fuzzy title/author matching
  fuzzy_threshold: 80  # Minimum similarity score (0-100) for fuzzy matching

# Sync Settings - Which book statuses to sync (can be overridden by CLI flags)
sync:
  include_statuses:
    want_to_read: true          # Status ID 1: Always synced
    currently_reading: false    # Status ID 2: Set to true to sync currently reading books
    read: false                 # Status ID 3: Set to true to sync already read books

# Transfer Settings
transfer:
  dry_run: false  # Set to true to simulate without actually transferring files
  skip_existing: true  # Skip files that already exist on E-reader
  folder_organization: "flat"  # Options: flat, author, series, author_series
  # Cleanup options - remove books from E-reader that aren't in sync list
  cleanup_enabled: false
  cleanup_sdr_folders: true  # Also remove .sdr reading data folders
  cleanup_protected_paths: []  # Paths to never delete (e.g., ["/mnt/us/documents/"])

# Automatic E-reader Sync — run a full shelf sync on a schedule
ereader_sync:
  enabled: false     # Set to true to sync the first configured E-reader automatically
  interval_hours: 1  # 1, 6, or 24 (offline E-readers are skipped until the next run)

# RSS Sync — automatically grab new releases matching wanted books
rss:
  enabled: false                    # Set to true to enable RSS polling
  cron_expression: "*/15 * * * *"   # How often to poll (cron format)
  max_age_days: 3                   # Only fetch items published in the last N days
  limit: 100                        # Max items to fetch per indexer per poll
  cleanup_retention_days: 60        # Delete seen-item records older than N days
  caps_cache_seconds: 3600          # Cache indexer capability checks for N seconds (1 hour)

# Logging Settings
logging:
  log_file: "bookotter.log"
  log_level: "INFO"  # DEBUG, INFO, WARNING, ERROR
  console_output: true
